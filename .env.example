DATABASE_URL="postgresql://excelhub_user:excelhub_password@localhost:5432/excelhub?schema=public"
NEXTAUTH_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
ADMIN_EMAIL="admin@excelhub.com"
ADMIN_PASSWORD="ChangeMe123!"

# Set to "true" only in local dev to seed sample templates/blog posts.
# Leave unset/empty in production: db:seed then creates only the admin user,
# categories, and search indexes, and you add real content via /admin.
SEED_DEMO=""

# Public contact email shown on /contact and /about.
NEXT_PUBLIC_CONTACT_EMAIL="hello@templatehub.co.in"

# Google AdSense publisher ID (from your AdSense account).
# Format: ca-pub-XXXXXXXXXXXXXXXX. The app also has this as a fallback.
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-7632787932597038"

# Ad unit (slot) IDs from your AdSense dashboard — the data-ad-slot values.
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE="5957507403"
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR="8840540241"

# Razorpay (GST pack checkout). Create a key pair in the Razorpay dashboard.
# Until these are set, the pack page asks buyers to email instead.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""